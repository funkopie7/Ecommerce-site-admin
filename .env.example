DATABASE_URL="postgresql://mercury:mercury_local_dev@localhost:5434/mercury_commerce"
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_STORE_URL="http://localhost:3901"
ADMIN_API_KEY="replace-with-a-long-random-admin-key"
# Needed for /api/admin/uploads (product photo -> .webp -> Supabase Storage).
# Auto-populated in Vercel by the Supabase Marketplace integration; for local
# dev against a self-hosted Postgres, pull them from the Supabase dashboard.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
# Razorpay Standard Checkout — test-mode keys from the Razorpay dashboard.
# KEY_SECRET must only ever live here (server-side); the storefront only
# needs the key id, via its own NEXT_PUBLIC_RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="replace-with-your-key-secret"
# From the Razorpay dashboard's Webhooks screen (a separate secret from the
# one above) — required for /api/webhooks/razorpay to verify deliveries.
RAZORPAY_WEBHOOK_SECRET="replace-with-your-webhook-secret"
