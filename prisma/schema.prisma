generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through Supabase's pooled connection (port
  // 6543/pgbouncer) — fine for normal queries, but `prisma migrate deploy`
  // needs a direct connection to take the advisory lock it coordinates
  // concurrent migration runs with, which a transaction-mode pooler doesn't
  // support and just hangs on. directUrl only affects migrate/introspect
  // commands, not the app's actual runtime connection.
  //
  // MUMBAI_ prefix: the database lives in ap-south-1 (Mumbai) so it sits
  // next to the people using the shop, instead of the us-east-1 default
  // that put every cart and sign-in a quarter-second round trip away.
  //
  // The prefix is what keeps the two Supabase projects from fighting, and
  // it also means the old integration can't quietly revert the cutover the
  // next time it syncs its own variables back.
  //
  // Storage moved too, after the database did (see migrateStorageToMumbai.mjs)
  // — every product-images object copied over, every Product.imageUrl
  // rewritten. lib/uploads.ts picks credentials per bucket: product-images
  // reads the MUMBAI_ vars, chat-images deliberately still reads the
  // unprefixed ones (short-lived, per-conversation attachments — never
  // migrated, never needed to be). Get that mapping wrong in uploads.ts and
  // it fails exactly like this comment once did: silently, for weeks, until
  // someone notices a picture that never uploaded.
  url       = env("MUMBAI_POSTGRES_PRISMA_URL")
  directUrl = env("MUMBAI_POSTGRES_URL_NON_POOLING")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  SIMULATED_PAID
  FAILED
}

model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  description String?
  imageUrl String?
  visible Boolean @default(true)
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(cuid())
  sku String @unique
  slug String @unique
  name String
  description String
  price Int
  compareAtPrice Int?
  cost Int
  stockQuantity Int @default(0)
  imageUrl String?
  hoverImageUrl String?
  images String[] @default([])
  visible Boolean @default(true)
  franchise String?
  character String?
  edition String?
  releaseDate DateTime?
  /* Whether this figure appears in the homepage's Featured drops row.
     Replaced a `badges String[]` pointing at a Tag vocabulary: one product in
     508 ever carried a badge, so the row it was meant to fill was actually
     populated by an arbitrary stride through the catalogue. A checkbox the
     shop owner ticks is both simpler and the thing they were reaching for. */
  featured Boolean @default(false)
  characterStory String?
  funFacts String[] @default([])
  wishlistItems WishlistItem[]
  conversations Conversation[]
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  cartItems CartItem[]
  orderItems OrderItem[]
  adjustments InventoryAdjustment[]
  collectionItems CollectionItem[]
  reviews Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collection {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  description String?
  imageUrl String?
  price Int
  compareAtPrice Int?
  visible Boolean @default(true)
  items CollectionItem[]
  wishlistItems WishlistItem[]
  cartItems CartItem[] @relation("CartItemCollection")
  orderItems OrderItem[] @relation("OrderItemCollection")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CollectionItem {
  id String @id @default(cuid())
  collectionId String
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int @default(1)
  @@unique([collectionId, productId])
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

/* One review per customer per product, enforced by the compound unique below
   — a second submission edits the first rather than stacking, which is the
   only honest way to keep an average meaningful.

   Reviews go live immediately (status PUBLISHED) instead of queuing for
   approval. A customer who posts and can't see their own words assumes it
   broke and posts again; and a shop that must approve each review before it
   appears is a shop whose ratings can't be trusted. The admin can HIDE one
   after the fact, which is the narrower power: it handles abuse and spam
   without quietly filtering out every three-star opinion.

   `verifiedPurchase` is stamped at write time by looking for an OrderItem
   from this customer for this product. Stored rather than derived so the
   badge can't change retroactively if an old order is ever cleaned up. */
model Review {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating Int
  title String?
  body String
  verifiedPurchase Boolean @default(false)
  status ReviewStatus @default(PUBLISHED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productId, customerId])
  // The product page's own query: this product's published reviews, newest
  // first. Without it every figure page pays a sequential scan of every
  // review in the shop.
  @@index([productId, status, createdAt])
}

model Customer {
  id String @id @default(cuid())
  name String
  email String @unique
  /* Optional, because an account created through Google has no password to
     hash. Everything that compares a password must therefore check this
     exists first — a null hash means "this account signs in with Google",
     not "any password works". */
  passwordHash String?
  googleId String? @unique
  phone String?
  imageUrl String?
  addresses Address[]
  cart Cart?
  orders Order[]
  wishlist Wishlist?
  conversations Conversation[]
  paymentIntents PaymentIntent[]
  reviews Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recipient String
  phone String
  line1 String
  line2 String?
  city String
  state String
  postalCode String
  country String @default("India")
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
}

model Cart {
  id String @id @default(cuid())
  customerId String @unique
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items CartItem[]
  updatedAt DateTime @updatedAt
}

model CartItem {
  id String @id @default(cuid())
  cartId String
  productId String
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  quantity Int
  // Set when this line was added via "add bundle to bag", so checkout can
  // detect a complete bundle and price it at the collection's price instead
  // of the sum of its parts. Cleared (not deleted) if the collection is
  // removed or the line is edited standalone — see checkout's priceBundles.
  collectionId String?
  collection Collection? @relation("CartItemCollection", fields: [collectionId], references: [id], onDelete: SetNull)
  @@unique([cartId, productId])
}

model Order {
  id String @id @default(cuid())
  number String @unique
  // Nullable so a walk-in sale isn't forced through a registered account —
  // see customerName/customerPhone below, which carry the walk-in's details
  // when customerId is null. A registered customer's order always has both
  // customerId set and these two blank; a manual walk-in order is the
  // reverse. Never both, never neither.
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String?
  customerPhone String?
  // Optional even for a walk-in: someone buying over the counter often won't
  // give an address, and the sale must not depend on one. When it is there,
  // it is the only way to send them a receipt — a walk-in has no account to
  // read one from. sendOrderConfirmation falls back to this when there is no
  // linked customer.
  customerEmail String?
  status OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  subtotal Int
  shipping Int @default(0)
  discountCode String?
  discountAmount Int @default(0)
  total Int
  // Cumulative payments recorded so far — kept in sync with the Payment log
  // below inside the same transaction, so filtering/sorting by it never
  // needs to aggregate the log at query time.
  amountPaid Int @default(0)
  payments Payment[]
  // Optional: an offline sale picked up in person has nowhere to ship.
  addressSnapshot Json?
  carrier String?
  trackingCode String?
  deliveryNotes String?
  // Stamped the moment a confirmation email is CLAIMED, not after it sends.
  // Three paths can complete the same order — the COD route, the Razorpay
  // verify route, and the payment.captured webhook that races it — so this
  // is what stops a customer getting the same email twice. A claim that
  // then fails to send is released again, so it can be retried.
  confirmationSentAt DateTime?
  items OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** One record per payment collected against an order — the paper trail behind Order.amountPaid. */
model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount Int
  method String?
  note String?
  recordedAt DateTime @default(now())
}

/** One row per Razorpay order we've quoted — created at /razorpay-order,
 * "claimed" (status CREATED -> FULFILLED, atomically, via an
 * updateMany/where-status guard) by whichever arrives first of: the
 * client's own /razorpay-verify call, or the payment.captured webhook.
 * That race-safe claim is what stops a webhook retry, or a webhook
 * arriving alongside a successful client verify, from ever creating two
 * Orders for the same payment. */
model PaymentIntent {
  id String @id @default(cuid())
  razorpayOrderId String @unique
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addressId String
  amount Int
  discountCode String?
  discountAmount Int @default(0)
  status String @default("CREATED") // CREATED | FULFILLED
  orderId String?
  createdAt DateTime @default(now())
}

/** Percent-off or flat-off codes, redeemable at checkout. `value` is a whole
 * percent (0-100) for PERCENT, or paise for FIXED — same minor-unit
 * convention as every other money field in this schema. `usedCount` is
 * incremented in the same transaction that creates the order it was applied
 * to, so it can never drift from the orders that actually redeemed it. */
model Coupon {
  id String @id @default(cuid())
  code String @unique
  type String // "PERCENT" | "FIXED"
  value Int
  active Boolean @default(true)
  maxUses Int?
  usedCount Int @default(0)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  name String
  sku String
  unitPrice Int
  quantity Int
  // Set when checkout confirmed a complete bundle and priced this line as
  // its prorated share of the collection's price rather than the product's
  // own price. Record only — profit/revenue math needs nothing but unitPrice.
  collectionId String?
  collection Collection? @relation("OrderItemCollection", fields: [collectionId], references: [id], onDelete: SetNull)
}

model InventoryAdjustment {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  delta Int
  resultingQuantity Int
  reason String
  adminEmail String
  createdAt DateTime @default(now())
}

model Wishlist {
  id String @id @default(cuid())
  customerId String @unique
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items WishlistItem[]
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id String @id @default(cuid())
  wishlistId String
  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String?
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([wishlistId, productId])
  @@unique([wishlistId, collectionId])
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageSender {
  CUSTOMER
  ADMIN
}

model Conversation {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId String?
  product Product? @relation(fields: [productId], references: [id])
  status ConversationStatus @default(OPEN)
  lastMessageAt DateTime @default(now())
  createdAt DateTime @default(now())
  messages Message[]
}

model Message {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender MessageSender
  body String
  /* A Storage URL in the chat-images bucket. Optional and independent of
     `body`: a message may be text, an image, or both — never neither, which
     the route's validation is what enforces. */
  imageUrl String?
  readByCustomer Boolean @default(false)
  readByAdmin Boolean @default(false)
  createdAt DateTime @default(now())
}

/* Store-wide settings the shop owner can change without a deploy.

   A single row, pinned to id "store" — there is one shop, and a settings
   table that can hold two of them is a table that will eventually hold two of
   them and then have to decide which is real. Reads upsert it into existence,
   so a fresh database needs no seeding step.

   `accentColor` is the storefront's one brand colour (the orange). It is
   injected as a CSS variable at the root, so every rule already written
   against var(--orange) follows it. `heroModelUrl` is the .glb standing in
   the homepage hero — bundled as a static file until now, which meant
   swapping the figure took a code change and a deploy. */
/* A saved hero configuration, switchable as a set.

   Changing the figure in the hero means changing eight things together — the
   model, the five lines of packaging copy, and the three colours — and getting
   one wrong leaves a Jujutsu Kaisen figure standing in a Demon Slayer box.
   Presets make that one click instead of eight edits, and make it reversible:
   the Tanjiro setup can be kept as a preset and returned to after trying
   another.

   Deliberately a copy of the values rather than a reference to them. A preset
   is a snapshot of how the hero looked, so editing the live settings must not
   silently rewrite the preset you would go back to. */
model HeroPreset {
  id String @id @default(cuid())
  name String @unique
  heroModelUrl String?
  heroModelName String?
  heroBoxLine String @default("ANIMATION")
  heroBoxNumber String @default("1000")
  heroBoxBanner String @default("DEMON SLAYER")
  heroBoxName String @default("TANJIRO")
  heroBoxSubtitle String @default("WITH NOODLES")
  heroBoxCheckLight String @default("#1E5B4F")
  heroBoxCheckDark String @default("#12181A")
  heroBoxNumberColor String @default("#FFFFFF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreSettings {
  id String @id @default("store")
  accentColor String @default("#E8622A")
  /* The second accent. Left null it is derived from the primary — roughly its
     opposite on the wheel, which is where the original blue sat relative to
     the orange. Set it and that derivation is overridden. It is the shop's
     contrast colour: the "just unboxed" sticker, the DC universe wash, and
     anywhere a second voice is needed against the accent. */
  secondaryColor String?
  /* Text colour for whatever sits on the dark band that reads from
     secondaryColor (the drops row, the footer). Left null, the storefront
     picks whichever of its own cream/ink reads better against that exact
     background — but a shop that picked a light secondary and wants a
     specific dark text (rather than the auto pick) can say so directly. */
  secondaryTextColor String?
  heroModelUrl String?
  heroModelName String?
  /* The words printed on the hero's POP! box. The artwork is drawn in code
     rather than shipped as an image, and every line of it was hardcoded to
     the figure the scene was built around — so uploading any other model put
     it in Tanjiro's packaging. Defaults are those original values, so a shop
     that never touches this looks exactly as it did.

     Stored as given, including case: these read as printed packaging, and
     forcing upper case would mangle a name that isn't meant to be shouted. */
  heroBoxLine String @default("ANIMATION")
  heroBoxNumber String @default("1000")
  heroBoxBanner String @default("DEMON SLAYER")
  heroBoxName String @default("TANJIRO")
  heroBoxSubtitle String @default("WITH NOODLES")
  /* The two squares of the checkerboard printed behind the figure, and the
     colour of the box's own sides. Sampled from the original figure's haori,
     so like the labels they were right for exactly one model. Hex, validated
     on write and again on read — these are drawn onto a canvas rather than
     into markup, but an unchecked value would still be handed to a WebGL
     material and silently render as black. */
  heroBoxCheckLight String @default("#1E5B4F")
  heroBoxCheckDark String @default("#12181A")
  /* The figure number in the top-right of the box. Its own field rather than
     reusing a check colour: it sits on the checkerboard, so it is the one
     piece of type whose contrast depends on choices made elsewhere in this
     block, and it needs to be tunable independently of them. */
  heroBoxNumberColor String @default("#FFFFFF")
  updatedAt DateTime @updatedAt
}
